class Solution {
public:
    int longestSubarray(vector<int>& nums) {
        if(nums.size() == 1)
            return 0;
        int left = 0 ;
        int right = 0 ;
        int zeroCount = 0 ; 
        bool zeroExist = 0;
        int sum = 0;
        int maxWindow = 0;
        for(right ; right < nums.size() ;right++) {
            sum += nums[right];
            if(nums[right] == 0)
            {
                zeroCount += 1;
                zeroExist = true;
            }
            while(zeroCount > 1) {
                if(nums[left] == 0)
                    zeroCount-=1;
                left++;
            }


            maxWindow = max(maxWindow , right  - left + 1);
        }
        if(zeroExist == false)
            return nums.size() - 1;
        if(sum == 0)
            return 0;
        return maxWindow - 1;

    }
};
