class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int i = 0 ;
        int j = k ;
        int mx = 0;
        for(int x = 0 ; x < k ;x++) {
            mx += nums[x];
        }

        int slidingWindowSum = mx;
        while( j < nums.size()) {
            slidingWindowSum = slidingWindowSum - nums[i++] + nums[j++];
            mx = max(mx , slidingWindowSum);
        }
        return (double)( mx / (double)k);
    }
};
