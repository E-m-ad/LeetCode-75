class Solution {
public:
    vector<int> asteroidCollision(vector<int>& asteroids) {
        stack<int> st;
        for(int i = 0 ; i < asteroids.size() ; i++) {
           bool add = true;
            while(!st.empty() && ( st.top() > 0 && asteroids[i] < 0 )) {
                int newAs = abs(asteroids[i]);
                int topEle = st.top();
                if( newAs >= topEle)
                    st.pop();
                if(newAs <= topEle)
                {
                    add = false;
                    break;
                }
            }
            if(add)
                st.push(asteroids[i]);
            
        }
        vector<int> ans(st.size());
        for(int i = st.size() - 1 ; i >= 0 ; i--){
            ans[i] = st.top();
            st.pop();
        }
        return ans;
    }
};
