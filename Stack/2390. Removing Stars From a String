class Solution {
public:
    string removeStars(string s) {
  stack<char> st;
    for (int i = 0; i < s.size(); i++)
    {
        char c = s[i];
        if (c == '*' && !st.empty())
            st.pop();
        if (c != '*')
            st.push(c);
    }
    string res = "";
    while (!st.empty())
    {
        res += st.top();
        st.pop();
    }
    reverse(res.begin(), res.end());
    return res;
    }
};
