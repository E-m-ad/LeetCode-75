class Solution {
public:
    string decodeString(string s) {
          stack<string> st;
    string result = "";
    for (int i = 0; i < s.size(); i++)
    {
        string encodedString = "";
        string numberOfRepeat = "";
        if (s[i] != ']')
            st.push(string(1, s[i]));
        else
        {

            while (!st.empty() && st.top() != "[")
            {
                encodedString += st.top();
                st.pop();
            }
            st.pop();
            while (!st.empty() && st.top() != "]" && st.top() != "[" && (st.top()[0] < 'a' || st.top()[0] > 'z'))
            {
                numberOfRepeat += st.top();
                st.pop();
            }
            reverse(numberOfRepeat.begin(), numberOfRepeat.end());
            int repeat = 0;
            for (int i = 0; i < numberOfRepeat.size(); i++)
                repeat += (numberOfRepeat[i] - '0') * pow(10, numberOfRepeat.size() - i - 1);

            while (repeat--)
                st.push(encodedString);
        }
    }
    string temp = "";
    while (st.empty() == false)
    {
        temp += st.top();
        st.pop();
    }
    reverse(temp.begin(), temp.end());
    result += temp;
    return result;
    }
};
