class Solution
{
public:
    string addBinary(string a, string b)
    {
        int i_a = a.size() - 1;
        int i_b = b.size() - 1;
        string result = "";
        int carry = 0;
        while (i_a >= 0 && i_b >= 0)
        {
            int res = ((a[i_a] - '0' + b[i_b] - '0') + carry) % 2;
            carry = (a[i_a] - '0' + b[i_b] - '0' + carry) / 2;
            result += res + '0';
            i_a--;
            i_b--;
        }
        while (i_a >= 0)
        {
            int res = ((a[i_a] - '0') + carry) % 2;
            carry = (a[i_a] - '0' + carry) / 2;
            result += res + '0';
            i_a--;
        }
        while (i_b >= 0)
        {
            int res = ((b[i_b] - '0') + carry) % 2;
            carry = (b[i_b] - '0' + carry) / 2;
            result += res + '0';
            i_b--;
        }
        if (carry == 1)
            result += '1';
        reverse(result.begin(), result.end());
        return result;
    }
};
