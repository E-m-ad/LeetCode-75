class Solution {
public:
    int equalPairs(vector<vector<int>>& v) {
        string st;
        unordered_map<string, int> stRow;
        for (auto vec : v)
        {
            for (int i : vec) {
                st += to_string(i);
                st+=",";
            }
            stRow[st] += 1;
            st = "";
        }
        unordered_map<string, int> stCol;
        int n = v[0].size();
        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < n; j++) {
                st += to_string(v[j][i]);
                 st+=",";
            }
            stCol[st] += 1;
            st = "";
        }
        int pairs = 0;
        for (auto it : stRow)
        {
            auto existInCol = stCol.find(it.first);
            if (existInCol != stCol.end())    
                pairs += it.second  *  existInCol->second ; 
        }
       return pairs;
    }
};
